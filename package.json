{
  "name": "ct-integration",
  "version": "0.0.1",
  "description": "Bridges ChurchTools calendar room bookings to Homematic IP heating control, with InfluxDB telemetry and an Uptime Kuma healthcheck.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "jest",
    "test:ci": "jest --maxWorkers=1 --detectOpenHandles",
    "test:ci:coverage": "jest --maxWorkers=1 --detectOpenHandles --coverage",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file reports/eslint.json || true",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "dupes": "jscpd .",
    "dupes:report": "jscpd . --reporters json,html --output reports/jscpd || true",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run dupes && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebamomann/cghh-smarthome-ct-integration.git"
  },
  "author": "Seba Momann <git@sebamomann.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sebamomann/cghh-smarthome-ct-integration/issues"
  },
  "homepage": "https://github.com/sebamomann/cghh-smarthome-ct-integration",
  "dependencies": {
    "@influxdata/influxdb-client": "^1.20.0",
    "axios": "^0.24.0",
    "cron": "^1.8.2",
    "dotenv": "^10.0.0",
    "fs-extra": "^10.0.0",
    "marked": "15.0.12",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "ws": "^8.2.3"
  },
  "devDependencies": {
    "@types/cron": "^2.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "jest": "^30.2.0",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
