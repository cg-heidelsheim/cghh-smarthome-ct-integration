{
  "name": "ct-integration",
  "version": "0.0.1",
  "description": "node.js port of the 3rd party Google Assistant SDK",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest",
    "test:ci": "jest --maxWorkers=1 --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "dupes": "jscpd .",
    "dupes:report": "jscpd . --reporters json,html --output reports/jscpd || true",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run dupes && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebamomann/cghh-smarthome-ct-integration.git"
  },
  "author": "Seba Momann <git@sebamomann.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sebamomann/cghh-smarthome-ct-integration/issues"
  },
  "homepage": "https://github.com/sebamomann/cghh-smarthome-ct-integration",
  "dependencies": {
    "@grpc/grpc-js": "^1.3.7",
    "@influxdata/influxdb-client": "^1.20.0",
    "axios": "^0.24.0",
    "cron": "^1.8.2",
    "dotenv": "^10.0.0",
    "fs-extra": "^10.0.0",
    "google-auth-library": "^7.0.4",
    "influx": "^5.9.2",
    "mkdirp": "^1.0.4",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "open": "^8.0.6",
    "protobufjs": "^6.10.2",
    "readline": "^1.3.0",
    "websocket": "^1.0.34",
    "ws": "^8.2.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "jest": "^30.2.0",
    "jscpd": "^5.2.1",
    "knip": "^6.36.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
