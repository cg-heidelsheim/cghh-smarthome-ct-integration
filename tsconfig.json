{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@util/*": ["src/util/*"],
      "@db/*": ["src/db/*"],
      "@churchtools/*": ["src/churchtools/*"],
      "@homematic/*": ["src/homematic/*"],
      "@timeseries/*": ["src/timeseries/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "index.js", "uptime.js"],
  "exclude": ["node_modules", "dist", "coverage", "reports", "persistent"]
}
